# Vinta 3 Environment Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_SECRET_KEY=vinta3_enterprise_secret_2026

# Multi-Provider LLM Router (BYOK Support)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL_PROVIDER=mock
DEFAULT_MODEL_NAME=gpt-4o

# Hybrid Memory & RAG
VECTOR_DB_PATH=./data/vinta3_vector_store.json
MEMORY_WINDOW_SIZE=30
ENABLE_SEMANTIC_MEMORY=true

# Security Guardrails & Execution
MAX_ITERATIONS=15
STEP_TIMEOUT_MS=30000
SANDBOX_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=3
